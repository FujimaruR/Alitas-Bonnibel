    "es": "Todos los tipos",
    "en": "All types"
  },
  "text.9af0a9c042": {
    "es": "DINE_IN",
    "en": "Dine-in"
  },
  "text.60ba402d92": {
    "es": "Orden #",
    "en": "Orden #"
  },
  "text.8283e635e4": {
    "es": "WINGS · BONELESS · PAPAS",
    "en": "WINGS · BONELESS · FRIES"
  },
  "text.dc2908faea": {
    "es": "Alitas que despiertan",
    "en": "Wings that awaken"
  },
  "text.e1c2c15f91": {
    "es": "el antojo desde la primera vista.",
    "en": "your cravings at first sight."
  },
  "text.a4e2968ca9": {
    "es": "Combos de alitas, boneless y papas con salsas que van desde el “apenas pica” hasta el “¿por qué hice esto?”. Pide, comparte y disfruta.",
    "en": "Wing, boneless and fries combos with sauces from mildly spicy to seriously hot. Order, share and enjoy."
  },
  "text.fce155c8e7": {
    "es": "Pide para llevar",
    "en": "Order takeaway"
  },
  "text.8270b6bb15": {
    "es": "⏰ Hoy abrimos de",
    "en": "⏰ Today we open from"
  },
  "text.40504f5b2d": {
    "es": "4:00 pm a 11:00 pm",
    "en": "4:00 pm to 11:00 pm"
  },
  "text.b0ffd1992b": {
    "es": "Hoy se antoja",
    "en": "Today's craving"
  },
  "text.9ad6e56c96": {
    "es": "Combo 12 Alitas",
    "en": "12-wing combo"
  },
  "text.538072c764": {
    "es": "Elige hasta 2 sabores, papas gajo y un dip cremoso.",
    "en": "Choose up to 2 flavors, potato wedges and a creamy dip."
  },
  "text.21b0ffbe82": {
    "es": "Pedir ahora!",
    "en": "Order now!"
  },
  "text.e2d4d54bd7": {
    "es": "⏰ Promo limitada",
    "en": "⏰ Limited promotion"
  },
  "text.e7d61d7734": {
    "es": "Salsas y sabores",
    "en": "Sauces and flavors"
  },
  "text.18c6d1e001": {
    "es": "Del “tranqui” al “¡trae leche por favor!”. Elige tu nivel de picor.",
    "en": "From mild to “bring me milk, please!”. Choose your heat level."
  },
  "text.0370105a81": {
    "es": "4+ sabores para combinar",
    "en": "4+ flavors to combine"
  },
  "text.6626a03bd1": {
    "es": "#FFA832",
    "en": "#FFA832"
  },
  "text.f62dbb2084": {
    "es": "Los favoritos de la casa",
    "en": "House favorites"
  },
  "text.8eca5ad6c9": {
    "es": "Estos se eligen solos. Los marcaste como ⭐ en admin.",
    "en": "The popular picks marked as ⭐ in the admin panel."
  },
  "text.88d921e627": {
    "es": "Cargando favoritos…",
    "en": "Loading favorites…"
  },
  "text.1528599e47": {
    "es": "Alitas con cariño de cocina casera.",
    "en": "Wings with homemade care."
  },
  "text.8dceacf736": {
    "es": "Alitas Bonnibel nace del amor por compartir comida rica, honesta y bien servida. Nada de porciones tristes: aquí se viene a comer a gusto.",
    "en": "Alitas Bonnibel comes from a love of sharing tasty, honest, generously served food. Come hungry and enjoy."
  },
  "text.65c0cb1fac": {
    "es": "Usamos ingredientes frescos, salsas preparadas al momento y combinaciones pensadas para que siempre encuentres algo nuevo que probar.",
    "en": "We use fresh ingredients, freshly prepared sauces and combinations that offer something new to try."
  },
  "text.0cad8ae0c3": {
    "es": "Combos pensados para compartir (o no compartir, tampoco juzgamos).",
    "en": "Combos for sharing (or keeping to yourself, we will not judge)."
  },
  "text.f0a40aa36e": {
    "es": "Niveles de picor",
    "en": "Heat levels"
  },
  "text.ffaae8dc41": {
    "es": "Desde salsas suaves hasta retos para valientes.",
    "en": "From mild sauces to challenges for the brave."
  },
  "text.e801cf9536": {
    "es": "Para llevar y en sitio",
    "en": "Takeaway and dine-in"
  },
  "text.1ffeac8b0e": {
    "es": "Pide para tu casa o ven a disfrutar la experiencia completa.",
    "en": "Order at home or visit for the full experience."
  },
  "text.b880d25e89": {
    "es": "Queremos ser “tu lugar de confianza” para alitas.",
    "en": "We want to be your trusted place for wings."
  },
