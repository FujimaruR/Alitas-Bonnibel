  "text.87c47b5200": {
    "es": "Más que alitas:",
    "en": "More than wings:"
  },
  "text.03005e5a76": {
    "es": "un lugar para el antojo.",
    "en": "a place for your cravings."
  },
  "text.e261ac6160": {
    "es": "Alitas Bonnibel nace con una idea simple: porciones generosas, salsas que se noten y una experiencia que se sienta “de casa”, pero con nivel.",
    "en": "Alitas Bonnibel started with a simple idea: generous portions, bold sauces and an experience that feels like home, with a restaurant touch."
  },
  "text.0c26d69f1c": {
    "es": "⏰ 4:00 pm – 11:00 pm · NL",
    "en": "⏰ 4:00 pm – 11:00 pm · NL"
  },
  "text.76fdf7faa4": {
    "es": "Salsas que se notan.",
    "en": "Sauces that stand out."
  },
  "text.a4431902eb": {
    "es": "Aquí no venimos a “cubrir” alitas, venimos a presumir salsa. Del clásico búfalo al mango habanero: sabor primero, siempre.",
    "en": "We do more than coat wings: we celebrate sauce. From classic buffalo to mango habanero, flavor always comes first."
  },
  "text.08624efeb9": {
    "es": "🔥 Picor real",
    "en": "🔥 Real heat"
  },
  "text.db4f50fe40": {
    "es": "🍋 Opciones frescas",
    "en": "🍋 Fresh options"
  },
  "text.90eed9d57d": {
    "es": "🍯 Dulce-picante",
    "en": "🍯 Sweet and spicy"
  },
  "text.8afc30a2bc": {
    "es": "Nuestra misión",
    "en": "Our mission"
  },
  "text.603b875f24": {
    "es": "Hacer que cada pedido sea fácil, rápido y delicioso: porción generosa, salsas memorables y papas crujientes siempre.",
    "en": "Make every order easy, fast and delicious, with generous portions, memorable sauces and crispy fries."
  },
  "text.92856a3737": {
    "es": "Calidad constante",
    "en": "Consistent quality"
  },
  "text.023a865e27": {
    "es": "Sabor auténtico",
    "en": "Authentic flavor"
  },
  "text.696cb30189": {
    "es": "Servicio cercano",
    "en": "Friendly service"
  },
  "text.21c3c91571": {
    "es": "Porciones generosas",
    "en": "Generous portions"
  },
  "text.3b2552834c": {
    "es": "Nada de porciones tristes. Aquí se viene a comer a gusto.",
    "en": "No tiny portions. Come hungry and enjoy your meal."
  },
  "text.62b81999bf": {
    "es": "Sabor con carácter",
    "en": "Flavor with character"
  },
  "text.d05d4c8964": {
    "es": "Salsas intensas, combinaciones y niveles de picor reales.",
    "en": "Intense sauces, combinations and real heat levels."
  },
  "text.9dc4d406c8": {
    "es": "Hecho con cariño",
    "en": "Made with care"
  },
  "text.f15ab617e7": {
    "es": "Queremos que se sienta casero, pero con nivel de restaurante.",
    "en": "We want a homemade feeling with restaurant quality."
  },
  "text.9d0a633bbf": {
    "es": "Cómo lo hacemos",
    "en": "How we do it"
  },
  "text.5ffe5f8498": {
    "es": "Un proceso simple, pero con detalles que hacen la diferencia.",
    "en": "A simple process with details that make a difference."
  },
  "text.6a5587bef7": {
    "es": "Pregunta por promos →",
    "en": "Ask about promotions →"
  },
  "text.6a714454b5": {
    "es": "Elegimos el sabor",
    "en": "Choose a flavor"
  },
  "text.9446b0b850": {
    "es": "Selecciona tus salsas: clásico, dulce-picante o algo más intenso.",
    "en": "Select your sauces: classic, sweet and spicy or something more intense."
  },
  "text.24d94fc662": {
    "es": "Cocinamos al momento",
    "en": "Cooked to order"
  },
  "text.4304423786": {
    "es": "Cocción controlada para que queden jugosas y crujientes.",
    "en": "Controlled cooking for juicy, crispy wings."
  },
  "text.27ba886cf1": {
    "es": "Empacamos y entregamos",
    "en": "Pack and deliver"
  },
  "text.f5e83a0431": {
    "es": "Todo bien servido, con aderezos y papas listas para disfrutar.",
    "en": "Everything served with dips and fries, ready to enjoy."
  },
  "text.6795b8ce22": {
    "es": "🍗 Haz tu pedido por WhatsApp",
    "en": "🍗 Order via WhatsApp"
  },
  "text.017ef4b7df": {
    "es": "Panel admin: lista, filtra y revisa el detalle de cada orden.",
    "en": "Admin panel: list, filter and view order details."
  },
  "text.0e911db114": {
    "es": "Todos los estatus",
    "en": "All statuses"
  },
